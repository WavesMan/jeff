FROM ghcr.io/astral-sh/uv:0.12.19 AS uv
FROM nvidia/cuda:12.8.1-cudnn-runtime-ubuntu24.04

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 UV_LINK_MODE=copy
WORKDIR /app
COPY --from=uv /uv /uvx /bin/
RUN apt-get update && apt-get install --no-install-recommends -y python3.12 python3.12-venv && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 10001 jeff
COPY pyproject.toml uv.lock README.md ./
RUN uv sync --frozen --no-dev --no-install-project
COPY src ./src
RUN chown -R jeff:jeff /app
USER jeff
ENV PATH=/app/.venv/bin:$PATH PYTHONPATH=/app/src UV_PYTHON=python3.12
CMD ["python3.12", "-m", "jeff.server"]
